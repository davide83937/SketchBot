<?xml version="1.0"?>
<robot name="first">

  <link name="base">
    <visual>
     <origin xyz="0 0 0.026" rpy="0 0 0"/>
       <geometry>
        <box size="0.03 0.03 0.052"/>
       </geometry>
       <material name="color0">
        <color rgba="0.2 0.3 0.7 1.0"/>
       </material>
    </visual>
  </link>

<joint name="joint0" type="revolute">
    <parent link="base"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.052" rpy="0 0 0"/>
    <limit lower="-1.57" upper="3.14" effort="10" velocity="1"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="base_link">
    <visual>
     <origin xyz="0 0 0.0" rpy="0 0 0"/>
       <geometry>
        <box size="0.01 0.01 0.01"/>
       </geometry>
       <material name="color1">
        <color rgba="0.2 0.6 0.1 1.0"/>
       </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm1"/>
    <origin xyz="0.04 0 0.0" rpy="0 0 0"/>
    <limit lower="0.0" upper="1.62" effort="10" velocity="1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="arm1">
    <visual>
     <origin xyz="0 0 0.04875" rpy="0 0 0"/>
       <geometry>
         <box size="0.01 0.01 0.0975"/>
       </geometry>
       <material name="color2">
         <color rgba="0.6 0.3 0.1 1.0"/>
       </material>
      </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="arm1"/>
    <child link="arm2"/>
    <origin xyz="0.002 0 0.0975" rpy="0 0 0"/> 
    <limit lower="0.0" upper="1.3" effort="10" velocity="1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="arm2">
    <visual>
     <origin xyz="0 0 0.06" rpy="0 0 0"/>
       <geometry>
         <box size="0.01 0.01 0.12"/>
       </geometry>
       <material name="color3">
         <color rgba="0.1 0.3 0.9 1.0"/>
       </material>
      </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="arm2"/>
    <child link="end_effector"/>
    <origin xyz="0.015 0 0.12" rpy="0 0 0"/>
    <limit lower="0" upper="2.98" effort="10" velocity="1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="end_effector">
    <visual>
     <origin xyz="0 0 0.0325" rpy="0 0 0"/>
       <geometry>
         <box size="0.01 0.01 0.065"/>
       </geometry>
       <material name="color3">
         <color rgba="0.6 0.1 0.9 1.0"/>
       </material>
      </visual>
  </link>

  <joint name="joint_tcp" type="fixed">
   <parent link="end_effector"/>
   <child link="tcp"/>
   <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="tcp"/>

</robot>