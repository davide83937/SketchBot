    <axis xyz="0 1 0"/>

    <limit
      lower="0"
      upper="1.5708"
      effort="3"
      velocity="2"/>

  </joint>



  <!-- PORTA PENNA -->
  <link name="pen_holder">

    <visual>

      <geometry>
        <cylinder radius="0.008" length="0.075"/>
      </geometry>

